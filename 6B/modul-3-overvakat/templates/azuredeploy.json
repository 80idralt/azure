{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.13.0",
  "parameters": {
    "namePrefix": {
      "type": "string",
      "defaultValue": "novatrix",
      "metadata": {
        "description": "Prefix for alla resursnamn, sa att allt hanger ihop."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "swedencentral",
      "metadata": {
        "description": "Region for resurserna."
      }
    },
    "storageName": {
      "type": "string",
      "metadata": {
        "description": "Namn for storage account."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_GRS"
      ],
      "metadata": {
        "description": "Redundansniva for storage-kontot"
      }
    },
    "adminIp": {
      "type": "string",
      "metadata": {
        "description": "Publik IP som far SSH-tillgang till hoppvarden."
      }
    },
    "sshPublicKey": {
      "type": "string",
      "metadata": {
        "description": "Publik SSH-nyckel for att logga in pa servrarna."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser-web",
      "metadata": {
        "description": "Adminanvandare pa VM:arna."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_B2ats_v2",
      "metadata": {
        "description": "Storlek pa VM:arna."
      }
    },
    "flowUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Power Automate HTTP-triggerns URL. Tom = ingen notifiering skickas."
      }
    },
    "vmDiskControllerType": {
      "type": "string",
      "defaultValue": "SCSI",
      "allowedValues": [
        "SCSI",
        "NVMe"
      ],
      "metadata": {
        "description": "Diskkontrollertyp, maste matcha vmSize (nyare Azure Boost-serier som Dv6 kraver NVMe)."
      }
    },
    "larmEpost": {
      "type": "string",
      "defaultValue": "idrisaltun@hotmail.com",
      "metadata": {
        "description": "Mottagare av larmmejlet från action group."
      }
    }
  },
  "variables": {
    "nsgWebName": "[format('nsg-{0}-web', parameters('namePrefix'))]",
    "vnetName": "[format('vnet-{0}', parameters('namePrefix'))]",
    "nsgDbName": "[format('nsg-{0}-db', parameters('namePrefix'))]",
    "nsgAdminName": "[format('nsg-{0}-admin', parameters('namePrefix'))]",
    "jumpVmName": "[format('vm-{0}-jump', parameters('namePrefix'))]",
    "jumpPipName": "[format('pip-{0}', variables('jumpVmName'))]",
    "jumpNicName": "[format('nic-{0}', variables('jumpVmName'))]",
    "appIdentityName": "[format('id-{0}-app', parameters('namePrefix'))]",
    "storagePeName": "[format('pe-{0}-storage', parameters('namePrefix'))]",
    "storageAccountName": "[format('{0}{1}', parameters('storageName'), substring(uniqueString(resourceGroup().id), 0, 6))]",
    "lbName": "[format('lb-{0}-web', parameters('namePrefix'))]",
    "lbPipName": "[format('pip-lb-{0}-web', parameters('namePrefix'))]",
    "vmssName": "[format('vmss-{0}-web', parameters('namePrefix'))]",
    "taggar": {
      "projekt": "novatrix",
      "modul": "6b-modul3"
    },
    "workspaceName": "[format('log-{0}', parameters('namePrefix'))]",
    "dcrName": "[format('dcr-{0}-web', parameters('namePrefix'))]",
    "actionGroupName": "[format('ag-{0}-drift', parameters('namePrefix'))]",
    "larmNamn": "[format('larm-cpu-{0}', parameters('namePrefix'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Deny",
          "ipRules": [
            {
              "value": "[parameters('adminIp')]",
              "action": "Allow"
            }
          ]
        }
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/default/arenden', variables('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "publicAccess": "None"
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgWebName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-Http-Https",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "*",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRanges": [
                "80",
                "443"
              ]
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgWebName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgDbName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgAdminName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "snet-web",
            "properties": {
              "addressPrefix": "10.0.1.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgWebName'))]"
              }
            }
          },
          {
            "name": "snet-db",
            "properties": {
              "addressPrefix": "10.0.2.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgDbName'))]"
              }
            }
          },
          {
            "name": "snet-admin",
            "properties": {
              "addressPrefix": "10.0.3.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgAdminName'))]"
              }
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgDbName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-Web-To-Storage",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "10.0.1.0/24",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "443"
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgAdminName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-SSH-Admin",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[parameters('adminIp')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "*",
              "destinationPortRange": "22"
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[variables('jumpPipName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('jumpNicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('jumpPipName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'snet-admin')]"
              },
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('jumpPipName'))]"
              }
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-03-01",
      "name": "[variables('jumpVmName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('jumpNicName'))]"
      ],
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[variables('jumpVmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": {
              "publicKeys": [
                {
                  "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                  "keyData": "[parameters('sshPublicKey')]"
                }
              ]
            }
          }
        },
        "storageProfile": {
          "diskControllerType": "[parameters('vmDiskControllerType')]",
          "imageReference": {
            "publisher": "Canonical",
            "offer": "ubuntu-24_04-lts",
            "sku": "server",
            "version": "latest"
          },
          "osDisk": {
            "name": "[format('{0}-osdisk', variables('jumpVmName'))]",
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Standard_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('jumpNicName'))]"
            }
          ]
        }
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('appIdentityName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'arenden'), variables('appIdentityName'))]",
      "scope": "[format('Microsoft.Storage/storageAccounts/{0}/blobServices/default/containers/arenden', variables('storageAccountName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageAccountName'), 'default', 'arenden')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdentityName'))]"
      ],
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdentityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]"
      }
    },
    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "privatelink.blob.core.windows.net",
      "location": "global",
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('privatelink.blob.core.windows.net/link-{0}', parameters('namePrefix'))]",
      "location": "global",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        }
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-09-01",
      "name": "[variables('storagePeName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ],
      "properties": {
        "subnet": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'snet-db')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[variables('storagePeName')]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
              "groupIds": [
                "blob"
              ]
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-09-01",
      "name": "[format('{0}/default', variables('storagePeName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', variables('storagePeName'))]",
        "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]"
      ],
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "config1",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', 'privatelink.blob.core.windows.net')]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[variables('lbPipName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Network/loadBalancers",
      "apiVersion": "2023-09-01",
      "name": "[variables('lbName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('lbPipName'))]"
      ],
      "properties": {
        "frontendIPConfigurations": [
          {
            "name": "frontend",
            "properties": {
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('lbPipName'))]"
              }
            }
          }
        ],
        "backendAddressPools": [
          {
            "name": "backend"
          }
        ],
        "probes": [
          {
            "name": "probe-https",
            "properties": {
              "protocol": "Https",
              "port": 443,
              "requestPath": "/",
              "intervalInSeconds": 5,
              "probeThreshold": 2
            }
          }
        ],
        "loadBalancingRules": [
          {
            "name": "rule-https",
            "properties": {
              "frontendIPConfiguration": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', variables('lbName'), 'frontend')]"
              },
              "backendAddressPool": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('lbName'), 'backend')]"
              },
              "probe": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/probes', variables('lbName'), 'probe-https')]"
              },
              "protocol": "Tcp",
              "frontendPort": 443,
              "backendPort": 443,
              "loadDistribution": "SourceIP",
              "idleTimeoutInMinutes": 4,
              "disableOutboundSnat": true
            }
          },
          {
            "name": "rule-http",
            "properties": {
              "frontendIPConfiguration": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', variables('lbName'), 'frontend')]"
              },
              "backendAddressPool": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('lbName'), 'backend')]"
              },
              "probe": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/probes', variables('lbName'), 'probe-https')]"
              },
              "protocol": "Tcp",
              "frontendPort": 80,
              "backendPort": 80,
              "loadDistribution": "SourceIP",
              "idleTimeoutInMinutes": 4,
              "disableOutboundSnat": true
            }
          }
        ],
        "outboundRules": [
          {
            "name": "outbound",
            "properties": {
              "frontendIPConfigurations": [
                {
                  "id": "[resourceId('Microsoft.Network/loadBalancers/frontendIPConfigurations', variables('lbName'), 'frontend')]"
                }
              ],
              "backendAddressPool": {
                "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('lbName'), 'backend')]"
              },
              "protocol": "All",
              "idleTimeoutInMinutes": 4
            }
          }
        ]
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Compute/virtualMachineScaleSets",
      "apiVersion": "2024-03-01",
      "name": "[variables('vmssName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('vmSize')]",
        "tier": "Standard",
        "capacity": 1
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdentityName'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/loadBalancers', variables('lbName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdentityName'))]"
      ],
      "properties": {
        "orchestrationMode": "Uniform",
        "overprovision": false,
        "upgradePolicy": {
          "mode": "Manual"
        },
        "virtualMachineProfile": {
          "osProfile": {
            "computerNamePrefix": "web",
            "adminUsername": "[parameters('adminUsername')]",
            "linuxConfiguration": {
              "disablePasswordAuthentication": true,
              "ssh": {
                "publicKeys": [
                  {
                    "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
                    "keyData": "[parameters('sshPublicKey')]"
                  }
                ]
              }
            },
            "customData": "[base64(format('#cloud-config\npackage_upgrade: true\npackages:\n- python3-venv\n- python3-pip\n- nginx\n- git\n- openssl\n- stress-ng\nwrite_files:\n- path: /etc/systemd/system/novatrix-form.service\n  content: |\n    [Unit]\n    Description=Novatrix arendemottagare (gunicorn)\n    After=network-online.target\n    Wants=network-online.target\n\n    [Service]\n    User=www-data\n    WorkingDirectory=/opt/novatrix\n    Environment=STORAGE_ACCOUNT={0}\n    Environment=CONTAINER=arenden\n    Environment=AZURE_CLIENT_ID={1}\n    Environment=FLOW_URL={2}\n    ExecStart=/opt/novatrix/venv/bin/gunicorn --bind 127.0.0.1:5000 app:app\n    Restart=on-failure\n\n    [Install]\n    WantedBy=multi-user.target\nruncmd:\n- git clone https://github.com/80idralt/azure.git /tmp/azure-repo\n- mkdir -p /opt/novatrix\n- cp /tmp/azure-repo/v39/app/app.py /opt/novatrix/app.py\n- cp /tmp/azure-repo/v39/app/requirements.txt /opt/novatrix/requirements.txt\n- cp /tmp/azure-repo/v39/public/index.html /var/www/html/index.html\n- cp /tmp/azure-repo/v39/app/nginx-arende.conf /etc/nginx/sites-available/default\n- python3 -m venv /opt/novatrix/venv\n- /opt/novatrix/venv/bin/pip install -r /opt/novatrix/requirements.txt\n- mkdir -p /etc/ssl/novatrix\n- openssl req -x509 -nodes -days 365 -newkey rsa:2048 -keyout /etc/ssl/novatrix/novatrix.key -out /etc/ssl/novatrix/novatrix.crt -subj /CN=novatrix\n- chown -R www-data:www-data /opt/novatrix\n- systemctl daemon-reload\n- systemctl enable --now novatrix-form.service\n- systemctl restart nginx\n', variables('storageAccountName'), reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdentityName')), '2023-01-31').clientId, replace(parameters('flowUrl'), '%', '%%')))]"
          },
          "storageProfile": {
            "diskControllerType": "[parameters('vmDiskControllerType')]",
            "imageReference": {
              "publisher": "Canonical",
              "offer": "ubuntu-24_04-lts",
              "sku": "server",
              "version": "latest"
            },
            "osDisk": {
              "createOption": "FromImage",
              "managedDisk": {
                "storageAccountType": "Standard_LRS"
              }
            }
          },
          "networkProfile": {
            "networkInterfaceConfigurations": [
              {
                "name": "nic-web",
                "properties": {
                  "primary": true,
                  "ipConfigurations": [
                    {
                      "name": "ipconfig1",
                      "properties": {
                        "subnet": {
                          "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), 'snet-web')]"
                        },
                        "loadBalancerBackendAddressPools": [
                          {
                            "id": "[resourceId('Microsoft.Network/loadBalancers/backendAddressPools', variables('lbName'), 'backend')]"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          },
          "extensionProfile": {
            "extensions": [
              {
                "name": "AzureMonitorLinuxAgent",
                "properties": {
                  "publisher": "Microsoft.Azure.Monitor",
                  "type": "AzureMonitorLinuxAgent",
                  "typeHandlerVersion": "1.21",
                  "autoUpgradeMinorVersion": true,
                  "enableAutomaticUpgrade": true,
                  "settings": {
                    "authentication": {
                      "managedIdentity": {
                        "identifier-name": "mi_res_id",
                        "identifier-value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('appIdentityName'))]"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "tags": "[variables('taggar')]"
    },
    {
      "type": "Microsoft.Insights/autoscalesettings",
      "apiVersion": "2022-10-01",
      "name": "[format('autoskala-{0}', parameters('namePrefix'))]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Compute/virtualMachineScaleSets', variables('vmssName'))]"
      ],
      "properties": {
        "name": "[format('autoskala-{0}', parameters('namePrefix'))]",
        "enabled": true,
        "targetResourceUri": "[resourceId('Microsoft.Compute/virtualMachineScaleSets', variables('vmssName'))]",
        "profiles": [
          {
            "name": "cpu",
            "capacity": {
              "minimum": "1",
              "maximum": "2",
              "default": "1"
            },
            "rules": [
              {
                "metricTrigger": {
                  "metricName": "Percentage CPU",
                  "metricNamespace": "microsoft.compute/virtualmachinescalesets",
                  "metricResourceUri": "[resourceId('Microsoft.Compute/virtualMachineScaleSets', variables('vmssName'))]",
                  "timeGrain": "PT1M",
                  "statistic": "Average",
                  "timeWindow": "PT5M",
                  "timeAggregation": "Average",
                  "operator": "GreaterThan",
                  "threshold": 70
                },
                "scaleAction": {
                  "direction": "Increase",
                  "type": "ChangeCount",
                  "value": "1",
                  "cooldown": "PT5M"
                }
              },
              {
                "metricTrigger": {
                  "metricName": "Percentage CPU",
                  "metricNamespace": "microsoft.compute/virtualmachinescalesets",
                  "metricResourceUri": "[resourceId('Microsoft.Compute/virtualMachineScaleSets', variables('vmssName'))]",
                  "timeGrain": "PT1M",
